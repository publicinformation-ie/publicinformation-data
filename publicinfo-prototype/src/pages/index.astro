---
import Layout from '../layouts/Layout.astro';
import AuthorityCard from '../components/AuthorityCard.astro';
import bodies from '../data/public_bodies.json';
---

<Layout title="Public Bodies in Ireland">
  <div class="page-container">
    <header class="page-header">
      <h1>Public Bodies in Ireland</h1>
      <p class="page-description">
        All Irish public bodies subject to the Freedom of Information Act 2014.
      </p>
    </header>

    {bodies.length > 0 ? (
      <ul class="authority-list">
        {bodies.map((body) => (
          <li key={body.public_body_id} class="authority-list__item">
            <AuthorityCard authority={body} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-message">No public bodies data available.</p>
    )}
  </div>
</Layout>

<style>
  .page-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .page-header {
    margin-bottom: var(--space-6);
  }

  .page-description {
    color: var(--color-grey-dark);
    font-size: var(--text-body);
  }

  .authority-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .authority-list__item {
    margin-bottom: var(--space-3);
  }

  .empty-message {
    color: var(--color-grey-mid);
    text-align: center;
    padding: var(--space-6) 0;
  }
</style>
