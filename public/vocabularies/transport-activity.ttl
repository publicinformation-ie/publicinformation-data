    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#WT-03>
    a skos:Concept ;
    skos:notation "WT-03" ;
    skos:prefLabel "Provide and maintain local water transport facilities"@en ;
