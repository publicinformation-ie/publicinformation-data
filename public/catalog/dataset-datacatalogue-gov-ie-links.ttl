@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://data.publicinformation.ie/dataset/datacatalogue-gov-ie-links>
    a dcat:Dataset ;
    dct:title "datacatalogue.gov.ie Links for Irish Public Bodies"@en ;
    dct:description "Links from Irish public bodies to their organisation page on datacatalogue.gov.ie, the Public Service Data Catalogue. That catalogue is a single information point where public sector bodies list the data they hold, including 'protected data' holdings under the EU Data Governance Act, and where data reusers can make a request; it inventories data holdings, unlike data.gov.ie, which publishes open datasets. Covers only the organisations that resolve to a canonical public body in the public-bodies dataset by name matching or a reviewed override — organisations without a matching register entry, such as offices that sit inside a parent department, are intentionally excluded."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
    dct:issued "2026-11-20"^^xsd:date ;
    dct:modified "2026-11-20"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://datacatalogue.gov.ie/> ;
    dcat:keyword "datacatalogue.gov.ie", "CKAN", "Ireland", "government", "data catalogue", "protected data"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "PublicInformation.ie" ;
        vcard:hasEmail <mailto:dave@publicinformation.ie> ;
    ] ;
    dct:relation <https://data.publicinformation.ie/dataset/public-bodies> ;

    dcat:distribution [
        a dcat:Distribution ;
        dct:title "datacatalogue.gov.ie Links (JSON-LD, latest)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ;
        dcat:accessURL <https://data.publicinformation.ie/latest/datacatalogue-gov-ie-links/datacatalogue-gov-ie-links.jsonld> ;
        dcat:downloadURL <https://data.publicinformation.ie/v1.0.0/datacatalogue-gov-ie-links/datacatalogue-gov-ie-links.jsonld> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "application/ld+json" ;
        dct:conformsTo <https://data.publicinformation.ie/schemas/datacatalogue-gov-ie-links.schema.json> ;
    ] , [
        a dcat:Distribution ;
        dct:title "datacatalogue.gov.ie Links (CSV, latest)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
        dcat:accessURL <https://data.publicinformation.ie/latest/datacatalogue-gov-ie-links/datacatalogue-gov-ie-links.csv> ;
        dcat:downloadURL <https://data.publicinformation.ie/v1.0.0/datacatalogue-gov-ie-links/datacatalogue-gov-ie-links.csv> ;
        dct:conformsTo <http://www.w3.org/ns/csvw> ;
        dct:conformsTo <https://data.publicinformation.ie/v1.0.0/datacatalogue-gov-ie-links/datacatalogue-gov-ie-links.csv-metadata.json> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "text/csv" ;
    ] .

