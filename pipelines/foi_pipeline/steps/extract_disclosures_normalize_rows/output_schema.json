{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "extract_disclosures_normalize_rows output",
  "description": "Output schema for the date normalization step",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "step": {"type": "string", "const": "extract_disclosures_normalize_rows"},
        "completed_at": {"type": "string", "format": "date-time"}
      },
      "required": ["step", "completed_at"]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "public_body_id": {"type": ["integer", "null"]},
          "name": {"type": ["string", "null"]},
          "file_url": {"type": "string"},
          "file_type": {"type": ["string", "null"]},
          "sheet_name": {"type": ["string", "null"]},
          "header_row_idx": {"type": ["integer", "null"]},
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {"type": ["string", "null"]}
            }
          },
          "missing_columns": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "required": ["public_body_id", "name", "file_url", "file_type"]
      }
    }
  },
  "required": ["metadata", "results"]
}
