<https://codeberg.org/gingertechie/publicinformation-data/dataset/public-bodies>
    a dcat:Dataset ;
    dct:title "Public Bodies in Ireland"@en ;
    dct:description "A comprehensive list of all public bodies in Ireland that are subject to Freedom of Information legislation, including their status and contact information."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
    dct:issued "2026-07-01"^^xsd:date ;
    dct:modified "2026-07-01T17:22:04Z"^^xsd:dateTime ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:accrualPeriodicity <http://purl.org/cld/freq/daily> ;
    dcat:keyword "public bodies", "FOI", "Ireland", "government", "freedom of information"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "PublicInformation.ie" ;
        vcard:hasEmail <mailto:dave@publicinformation.ie> ;
    ] ;
    prov:hadPrimarySource <https://www.cso.ie/en/media/csoie/releasespublications/documents/ep/registerofpublicsectorbodies/2025h1/PRPBI2025H1TBL1.1csv.csv> ;
    prov:wasDerivedFrom <https://codeberg.org/gingertechie/publicinformation-data/public/pipeline-data.json> ;
    prov:wasGeneratedBy [
        a prov:Activity ;
        prov:startedAtTime "2026-07-01T17:22:04Z"^^xsd:dateTime ;
        prov:wasAssociatedWith [
            a prov:Agent ;
            foaf:name "PublicInformation.ie Pipeline Slice 1 Transformer" ;
            schema:url <https://codeberg.org/gingertechie/publicinformation-data> ;
        ] ;
    ] ;
    dcat:distribution [
        a dcat:Distribution ;
        dct:title "Public Bodies (JSON-LD)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ;
        dcat:accessURL <https://codeberg.org/gingertechie/publicinformation-data/public/public-bodies.jsonld> ;
        dcat:downloadURL <https://codeberg.org/gingertechie/publicinformation-data/public/public-bodies.jsonld> ;
