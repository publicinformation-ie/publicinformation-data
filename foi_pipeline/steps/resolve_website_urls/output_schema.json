{
  "type": "object",
  "required": ["metadata", "public_bodies"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["step", "completed_at"],
      "properties": {
        "step": { "type": "string" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "public_bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["public_body_id", "name", "official_website_url", "status"],
        "properties": {
          "public_body_id": { "type": "integer" },
          "name": { "type": "string" },
          "official_website_url": { "type": "string", "format": "uri" },
          "status": {
            "type": "object",
            "additionalProperties": true
          },
          "overridden": { "type": "boolean" }
        }
      }
    }
  }
}
