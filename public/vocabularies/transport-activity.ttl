<https://data.publicinformation.ie/ns/transport-activity#RT-16>
    a skos:Concept ;
    skos:notation "RT-16" ;
    skos:prefLabel "Provide passenger information infrastructure for road transport"@en ;
    skos:definition "Physical passenger information facilities and infrastructure associated with road passenger transport."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT4> ;
