<https://data.publicinformation.ie/dataset/cofog-1999>
    a dcat:Dataset ;
    dct:title "COFOG 1999 vocabulary"@en ;
    dct:description "The United Nations' Classification of the Functions of Government (COFOG) 1999 as an open vocabulary: ten divisions, 69 groups and 109 classes, each class marked as a collective or individual service. Used to classify agenda-item topics in the SPC meetings dataset."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
