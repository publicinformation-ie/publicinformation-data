    a skos:Concept ;
    skos:notation "PP" ;
    skos:prefLabel "Programme partners"@en ;
    skos:definition "Other partners, e.g. Fáilte Ireland."@en ;
    skos:altLabel "programme partners"@en ;
    skos:scopeNote "Kind: category"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-raci-party> .

<https://data.publicinformation.ie/ns/transport-raci-party#TP>
    a skos:Concept ;
    skos:notation "TP" ;
    skos:prefLabel "Third parties"@en ;
    skos:definition "Utilities, developers, event organisers, landowners and the public. Accountable only under B14."@en ;
    skos:altLabel "third parties"@en ;
    skos:scopeNote "Kind: category"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-raci-party> .

<https://data.publicinformation.ie/ns/transport-raci-party#AGS>
    a skos:Concept ;
    skos:notation "AGS" ;
    skos:prefLabel "An Garda Síochána"@en ;
