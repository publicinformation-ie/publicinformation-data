@prefix prov: <http://www.w3.org/ns/prov#> .

<https://publicinformation-ie.codeberg.page/publicinformation-data/dataset/who-does-what>
    a dcat:Dataset ;
    dct:title "Who Does What Links for Irish Public Bodies"@en ;
    dct:description "Links from Irish public bodies to their page on gov.ie's 'Who Does What' campaign, a plain-English description of each body's functions. Covers the 27 bodies in the campaign's own scope, not all public bodies."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
    dct:issued "2026-07-08"^^xsd:date ;
    dct:modified "2026-07-08"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:keyword "Who Does What", "gov.ie", "Ireland", "government", "open data"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "PublicInformation.ie" ;
        vcard:hasEmail <mailto:dave@publicinformation.ie> ;
    ] ;
    dct:relation <https://publicinformation-ie.codeberg.page/publicinformation-data/dataset/public-bodies> ;

    dcat:distribution [
        a dcat:Distribution ;
        dct:title "Who Does What Links (JSON-LD, latest)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ;
        dcat:accessURL <https://publicinformation-ie.codeberg.page/publicinformation-data/latest/who-does-what/who-does-what.jsonld> ;
        dcat:downloadURL <https://publicinformation-ie.codeberg.page/publicinformation-data/v1.0.0/who-does-what/who-does-what.jsonld> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "application/ld+json" ;
        dct:conformsTo <https://publicinformation-ie.codeberg.page/publicinformation-data/schemas/who-does-what.schema.json> ;
    ] , [
        a dcat:Distribution ;
        dct:title "Who Does What Links (CSV, latest)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
        dcat:accessURL <https://publicinformation-ie.codeberg.page/publicinformation-data/latest/who-does-what/who-does-what.csv> ;
        dcat:downloadURL <https://publicinformation-ie.codeberg.page/publicinformation-data/v1.0.0/who-does-what/who-does-what.csv> ;
        dct:conformsTo <http://www.w3.org/ns/csvw> ;
        dct:conformsTo <https://publicinformation-ie.codeberg.page/publicinformation-data/v1.0.0/who-does-what/who-does-what.csv-metadata.json> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "text/csv" ;
    ] .

