    "size": 16.0,
    "bbox": [
     220.16,
     226.73,
     542.86,
     248.89
    ],
    "block": 2,
    "line": 2,
    "span": 0
   },
   {
    "text": "Framework. Transport is a key enabler ",
    "font": "Lato-Bold",
    "size": 16.0,
    "bbox": [
     220.16,
     245.93,
     492.27,
     268.09
    ],
    "block": 2,
    "line": 3,
    "span": 0
   },
   {
    "text": "of the National Strategic Outcomes and ",
    "font": "Lato-Bold",
    "size": 16.0,
    "bbox": [
     220.16,
     265.13,
     504.85,
     287.29
    ],
    "block": 2,
    "line": 4,
    "span": 0
   },
   {
    "text": "the appropriate transport investment can ",
    "font": "Lato-Bold",
    "size": 16.0,
    "bbox": [
     220.16,
     284.33,
     516.43,
     306.49
    ],
    "block": 2,
    "line": 5,
    "span": 0
   },
   {
    "text": "facilitate these outcomes across a range of ",
    "font": "Lato-Bold",
    "size": 16.0,
    "bbox": [
