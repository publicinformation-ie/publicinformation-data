    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-15>
    a skos:Concept ;
    skos:notation "RT-15" ;
    skos:prefLabel "Provide road-based public transport interchange facilities"@en ;
    skos:definition "Bus stations, interchange areas and associated physical facilities. Classify individual rail or ferry components under their respective modes."@en ;
