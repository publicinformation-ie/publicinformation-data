    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-36>
    a skos:Concept ;
    skos:notation "RT-36" ;
    skos:prefLabel "Control works on public roads by others"@en ;
    skos:definition "Road opening licences (s.13(10) Roads Act 1993; MapRoad Roadworks Licensing), sectoral consents for statutory undertakers, s.101D RTA 1961 directions, co-ordination of works, the licence holder's works and reinstatement, and enforcement."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT1> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S10, S11, S13b, S14, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-37>
    a skos:Concept ;
    skos:notation "RT-37" ;
    skos:prefLabel "Temporarily close roads and manage temporary traffic arrangements"@en ;
    skos:definition "Temporary road closure orders for events, works or other purposes (s.75 Roads Act 1993; Arts 12 and 14 Roads Regulations 1994), road works speed limit orders (s.10 RTA 2004), temporary traffic management, offences and cost recovery."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT8> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S11, S13b, S14, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

