    dct:relation <https://data.publicinformation.ie/dataset/spc-meetings> ;
    dcat:keyword "COFOG", "classification", "vocabulary", "SKOS", "government functions", "open data"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
