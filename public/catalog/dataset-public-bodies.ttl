@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://publicinformation-ie.codeberg.page/publicinformation-data/dataset/public-bodies>
    a dcat:Dataset ;
    dct:title "Public Bodies in Ireland"@en ;
    dct:description "All 883 public sector bodies in Ireland known to PublicInformation.ie, with their Freedom of Information (FOI) status, CSO sector/NACE classification, and parent/department relationships. Contact email addresses and crawl-status detail are included where successfully crawled from each body's published FOI page."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
    dct:issued "2026-07-02"^^xsd:date ;
    dct:modified "2026-07-10"^^xsd:date ;
    owl:versionInfo "2.0.0" ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:accrualPeriodicity <http://purl.org/cld/freq/daily> ;
    dcat:keyword "public bodies", "FOI", "Ireland", "government", "CSO", "NACE"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "PublicInformation.ie" ;
        vcard:hasEmail <mailto:dave@publicinformation.ie> ;
    ] ;
    prov:hadPrimarySource <https://www.gov.ie/en/departments/> , <https://www.cso.ie/> ;

    dcat:distribution [
        a dcat:Distribution ;
        dct:title "Public Bodies (JSON-LD, latest)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ;
        dcat:accessURL <https://publicinformation-ie.codeberg.page/publicinformation-data/latest/public-bodies/public-bodies.jsonld> ;
        dcat:downloadURL <https://publicinformation-ie.codeberg.page/publicinformation-data/v2.0.0/public-bodies/public-bodies.jsonld> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "application/ld+json" ;
        dct:conformsTo <https://publicinformation-ie.codeberg.page/publicinformation-data/schemas/public-bodies.schema.json> ;
    ] , [
        a dcat:Distribution ;
        dct:title "Public Bodies (CSV, latest)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
        dcat:accessURL <https://publicinformation-ie.codeberg.page/publicinformation-data/latest/public-bodies/public-bodies.csv> ;
        dcat:downloadURL <https://publicinformation-ie.codeberg.page/publicinformation-data/v2.0.0/public-bodies/public-bodies.csv> ;
        dct:conformsTo <http://www.w3.org/ns/csvw> ;
        dct:conformsTo <https://publicinformation-ie.codeberg.page/publicinformation-data/v2.0.0/public-bodies/public-bodies.csv-metadata.json> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "text/csv" ;
    ] .

<https://publicinformation-ie.codeberg.page/publicinformation-data/dataset/public-bodies>
    prov:wasGeneratedBy [
        a prov:Activity ;
        prov:startedAtTime "2026-07-10T00:00:00Z"^^xsd:dateTime ;
        prov:wasAssociatedWith [
            a prov:Agent ;
            prov:actedOnBehalfOf <https://www.publicinformation.ie/> ;
            foaf:name "PublicInformation.ie Pipeline" ;
            foaf:homepage <https://codeberg.org/publicinformation-ie/publicinformation-data> ;
        ] ;
    ] .
