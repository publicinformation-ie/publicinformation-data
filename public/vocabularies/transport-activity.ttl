    skos:note "Stages: S1, S2, S11, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-34>
    a skos:Concept ;
    skos:notation "RT-34" ;
    skos:prefLabel "Audit accessibility of transport infrastructure"@en ;
