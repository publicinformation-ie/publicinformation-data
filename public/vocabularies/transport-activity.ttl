<https://data.publicinformation.ie/ns/transport-activity#WT-04>
    a skos:Concept ;
    skos:notation "WT-04" ;
    skos:prefLabel "Plan or support local water passenger and freight services"@en ;
    skos:definition "Planning, coordination or support of water passenger and freight services where a Local Authority has an established role."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#WT3> ;
