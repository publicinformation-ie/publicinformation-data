---
import Layout from '../layouts/Layout.astro';
import AuthorityCard from '../components/AuthorityCard.astro';
import bodies from '../data/public_bodies.json';

// Category slug to display name mapping
const categoryMap: Record<string, string> = {
  'government-department': 'Government Departments',
  'public-service-body': 'Public Service Bodies',
  'local-authority': 'Local Authorities',
};

// Get all category slugs for static generation
export function getStaticPaths() {
  const slugs = ['government-department', 'public-service-body', 'local-authority'];
  return slugs.map((slug) => ({
    params: { category: slug },
  }));
}

const { category } = Astro.params;

// Map slug back to category string for filtering
const slugToCategory: Record<string, string> = {
  'government-department': 'government department',
  'public-service-body': 'public service body',
  'local-authority': 'local authority',
};

const categoryName = categoryMap[category];
const categoryFilter = slugToCategory[category];

// Filter bodies by category
const filteredBodies = categoryFilter 
  ? bodies.filter(b => b.public_body_category === categoryFilter)
  : [];

// Capitalize first letter for display
const displayName = categoryName || category;
--- 

<Layout title={`${displayName} - Public Bodies in Ireland`} showBackLink={true}>
  <div class="page-container">
    <header class="page-header">
      <h1>{displayName}</h1>
      <p class="page-description">
        {filteredBodies.length} public {filteredBodies.length === 1 ? 'body' : 'bodies'} 
        in this category subject to the Freedom of Information Act 2014.
      </p>
    </header>

    {filteredBodies.length > 0 ? (
      <ul class="authority-list">
        {filteredBodies.map((body) => (
          <li key={body.public_body_id} class="authority-list__item">
            <AuthorityCard authority={body} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-message">No public bodies found in this category.</p>
    )}
  </div>
</Layout>

<style>
  .page-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .page-header {
    margin-bottom: var(--space-6);
  }

  .page-description {
    color: var(--color-grey-dark);
    font-size: var(--text-body);
  }

  .authority-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .authority-list__item {
    margin-bottom: var(--space-3);
  }

  .empty-message {
    color: var(--color-grey-mid);
    text-align: center;
    padding: var(--space-6) 0;
  }
</style>
