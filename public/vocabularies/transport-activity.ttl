    a skos:Concept ;
    skos:notation "RT-07" ;
    skos:prefLabel "Provide pedestrian crossings and crossing infrastructure"@en ;
    skos:definition "Physical provision and maintenance of pedestrian crossings, refuge islands, tactile paving and associated infrastructure."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT2> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S2, S3, S4, S5, S5G, S6, S7a, S7b, S7c, S9, S10, S12, S15"@en ;
