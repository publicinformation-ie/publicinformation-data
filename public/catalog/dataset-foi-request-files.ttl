@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://data.publicinformation.ie/dataset/foi-request-files>
    a dcat:Dataset ;
    dct:title "FOI Request Files in Ireland"@en ;
    dct:description "Source disclosure log files (PDF and Excel) published by Irish public bodies under Freedom of Information legislation, each linked to exactly one public body in the Public Bodies dataset."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
    dct:issued "2026-07-02"^^xsd:date ;
    dct:modified "2026-07-13"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:keyword "FOI", "disclosure log", "Ireland", "government", "open data"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "PublicInformation.ie" ;
        vcard:hasEmail <mailto:dave@publicinformation.ie> ;
    ] ;
    dct:relation <https://data.publicinformation.ie/dataset/public-bodies> ;

    dcat:distribution [
        a dcat:Distribution ;
        dct:title "FOI Request Files (JSON-LD, latest)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ;
        dcat:accessURL <https://data.publicinformation.ie/latest/foi-request-files/foi-request-files.jsonld> ;
        dcat:downloadURL <https://data.publicinformation.ie/v1.0.0/foi-request-files/foi-request-files.jsonld> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "application/ld+json" ;
        dct:conformsTo <https://data.publicinformation.ie/schemas/foi-request-files.schema.json> ;
    ] , [
        a dcat:Distribution ;
        dct:title "FOI Request Files (CSV, latest)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
        dcat:accessURL <https://data.publicinformation.ie/latest/foi-request-files/foi-request-files.csv> ;
        dcat:downloadURL <https://data.publicinformation.ie/v1.0.0/foi-request-files/foi-request-files.csv> ;
        dct:conformsTo <http://www.w3.org/ns/csvw> ;
        dct:conformsTo <https://data.publicinformation.ie/v1.0.0/foi-request-files/foi-request-files.csv-metadata.json> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "text/csv" ;
    ] .

<https://data.publicinformation.ie/dataset/foi-request-files>
    prov:wasGeneratedBy [
        a prov:Activity ;
        prov:startedAtTime "2026-07-02T00:00:00Z"^^xsd:dateTime ;
        prov:wasAssociatedWith [
            a prov:Agent ;
            prov:actedOnBehalfOf <https://www.publicinformation.ie/> ;
            foaf:name "PublicInformation.ie Pipeline" ;
            foaf:homepage <https://github.com/publicinformation-ie/publicinformation-data> ;
        ] ;
    ] .
