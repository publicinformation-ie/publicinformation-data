     693.89,
     542.46,
     707.36
    ],
    "block": 9,
    "line": 2,
    "span": 0
   },
   {
    "text": "role to play in achieving these targets. By delivering sustainable mobility ",
    "font": "Lato-Regular",
    "size": 10.0,
    "bbox": [
