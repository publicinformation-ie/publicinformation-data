{
  "type": "object",
  "required": ["metadata", "results"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["step", "completed_at"],
      "properties": {
        "step": { "type": "string" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["public_body_id", "name", "disclosure_page_url", "file_url", "file_type", "link_text"],
        "properties": {
          "public_body_id": { "type": "integer" },
          "name": { "type": "string" },
          "disclosure_page_url": { "type": "string" },
          "file_url": { "type": "string" },
          "file_type": { "enum": ["pdf", "xlsx", "xls"] },
          "link_text": { "type": "string" },
          "overridden": { "type": "boolean" }
        }
      }
    }
  }
}
