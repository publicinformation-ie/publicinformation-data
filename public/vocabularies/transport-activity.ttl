    skos:notation "RT-26" ;
    skos:prefLabel "Regulate shared micromobility services"@en ;
    skos:definition "Bye-laws for stationless or shared bike and e-scooter hire (s.199 LGA 2001; reserved) and operator licences and permits issued under them. Separate from service provision (RT-41)."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT8> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S13a, S13b, S14, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-27>
    a skos:Concept ;
    skos:notation "RT-27" ;
    skos:prefLabel "Regulate taxi and small public service vehicle services"@en ;
    skos:definition "Statutory regulation and licensing of SPSVs and taxi services, including relevant standards and conditions."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT8> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S13a, S13b, S14, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-28>
    a skos:Concept ;
    skos:notation "RT-28" ;
    skos:prefLabel "Regulate road passenger and freight operators"@en ;
    skos:definition "Commercial operator licensing and regulatory controls for passenger and haulage operators, distinguishing national licensing from local road controls."@en ;
