---
import Layout from '../../layouts/Layout.astro';
import bodies from '../../data/public_bodies_detailed.json';

// Generate static paths for all public bodies
export function getStaticPaths() {
  return Object.values(bodies).map((body: any) => ({
    params: { id: body.public_body_id.toString() },
  }));
}

// Get the public body ID from the URL
const { id } = Astro.params;

// Find the public body data
const body = Object.values(bodies).find((b: any) => b.public_body_id == id);

// If no body found, show 404
if (!body) {
  Astro.redirect('/404', 404);
}
---

<Layout title={`${body.public_body_name} - Public Bodies in Ireland`} showBackLink={true}>
  <main class="max-w-4xl mx-auto px-4 py-8">
    <!-- Public Body Header -->
    <header class="mb-8">
      <h1 class="text-3xl font-bold mb-2">{body.public_body_name}</h1>
      {body.public_body_short_name && (
        <p class="text-lg text-gray-500">({body.public_body_short_name})</p>
      )}
      <p class="text-sm text-gray-400 capitalize mt-2">{body.public_body_category}</p>
    </header>

    <!-- Info Section -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4 border-b border-gray-200 pb-2">Information</h2>
      
      <div class="space-y-4">
        <!-- Public Body URL -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <span class="text-gray-600 w-40 shrink-0">Public Body URL:</span>
          {body.public_body_url ? (
            <a 
              href={body.public_body_url}
              class="text-blue-700 hover:underline break-all"
              target="_blank"
              rel="noopener noreferrer"
            >
              {body.public_body_url}
            </a>
          ) : (
            <span class="text-gray-400 italic">Not available</span>
          )}
        </div>

        <!-- FOI Email -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <span class="text-gray-600 w-40 shrink-0">FOI Email:</span>
          {body.foi_contact_email ? (
            <span class="break-all">{body.foi_contact_email}</span>
          ) : (
            <span class="text-gray-400 italic">Not available</span>
          )}
        </div>

        <!-- FOI Disclosure Page -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <span class="text-gray-600 w-40 shrink-0">FOI Disclosure Page:</span>
          {body.foi_disclosure_page_url ? (
            <a 
              href={body.foi_disclosure_page_url}
              class="text-blue-700 hover:underline break-all"
              target="_blank"
              rel="noopener noreferrer"
            >
              {body.foi_disclosure_page_url}
            </a>
          ) : (
            <span class="text-gray-400 italic">Not available</span>
          )}
        </div>
      </div>
    </section>

    <!-- Disclosure Files Section -->
    <section>
      <h2 class="text-xl font-semibold mb-4 border-b border-gray-200 pb-2">
        Disclosure Files ({body.disclosure_files?.length || 0})
      </h2>
      
      {body.disclosure_files && body.disclosure_files.length > 0 ? (
        <>
          <!-- Desktop Table View -->
          <div class="hidden sm:block overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Date Added
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    File Name
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Action
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {body.disclosure_files.map((file: any, index: number) => (
                  <tr key={index} class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      {file.date_added}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <span class="font-mono text-xs">{file.document_name}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                      <a 
                        href={file.document_url}
                        class="text-blue-700 hover:underline"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Open
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Mobile Card View -->
          <div class="sm:hidden space-y-3">
            {body.disclosure_files.map((file: any, index: number) => (
              <div key={index} class="border rounded-lg p-4 hover:bg-gray-50">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1">
                    <p class="text-sm text-gray-600 mb-1">{file.date_added}</p>
                    <p class="font-mono text-sm break-all">{file.document_name}</p>
                  </div>
                  <a 
                    href={file.document_url}
                    class="text-blue-700 hover:underline text-sm whitespace-nowrap shrink-0"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Open
                  </a>
                </div>
              </div>
            ))}
          </div>
        </>
      ) : (
        <p class="text-gray-500 italic">No disclosure files available.</p>
      )}
    </section>
  </main>
</Layout>
