@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://data.publicinformation.ie/dataset/documents>
    a dcat:Dataset ;
    dct:title "Transport Policy Documents (Markdown bundles)"@en ;
    dct:description "Reproducible per-document bundles (Markdown sections, figures, llms.txt) of the curated transport-policy PDFs that convert fully; documents that do not (coverage gaps) are listed under `failed` in `index.json`. Each published document is linked to its `policy_id` and `policy_role`."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
    dct:issued "2026-10-13"^^xsd:date ;
    dct:modified "2026-10-13"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:keyword "transport", "documents", "Markdown", "Ireland", "open data"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "PublicInformation.ie" ;
        vcard:hasEmail <mailto:dave@publicinformation.ie> ;
    ] ;
    dct:relation <https://data.publicinformation.ie/dataset/transport-policies> ;

    dcat:distribution [
        a dcat:Distribution ;
        dct:title "Documents index (JSON, latest)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ;
        dcat:accessURL <https://data.publicinformation.ie/documents/index.json> ;
        dcat:downloadURL <https://data.publicinformation.ie/documents/index.json> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "application/json" ;
    ] .

<https://data.publicinformation.ie/dataset/documents>
    prov:wasGeneratedBy [
        a prov:Activity ;
        prov:startedAtTime "2026-10-13T00:00:00Z"^^xsd:dateTime ;
        prov:wasAssociatedWith [
            a prov:Agent ;
            prov:actedOnBehalfOf <https://www.publicinformation.ie/> ;
            foaf:name "PublicInformation.ie Pipeline" ;
            foaf:homepage <https://github.com/publicinformation-ie/publicinformation-data> ;
        ] ;
    ] .
