@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://data.publicinformation.ie/ns/transport-subdomain>
    a skos:ConceptScheme ;
    dct:title "Transport subdomains (retired)"@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:description "Retired transport subdomain vocabulary. Each term is deprecated and linked to the transport-activity grouping that replaces it. The CSV and its CSVW metadata stay published unchanged at their existing URLs."@en ;
    skos:hasTopConcept <https://data.publicinformation.ie/ns/transport-subdomain#infra/national-roads>, <https://data.publicinformation.ie/ns/transport-subdomain#infra/regional-local-roads>, <https://data.publicinformation.ie/ns/transport-subdomain#infra/active-travel>, <https://data.publicinformation.ie/ns/transport-subdomain#infra/bus>, <https://data.publicinformation.ie/ns/transport-subdomain#infra/heavy-rail>, <https://data.publicinformation.ie/ns/transport-subdomain#infra/light-rail>, <https://data.publicinformation.ie/ns/transport-subdomain#infra/kerbside>, <https://data.publicinformation.ie/ns/transport-subdomain#infra/ports-airfields>, <https://data.publicinformation.ie/ns/transport-subdomain#svc/pso-bus>, <https://data.publicinformation.ie/ns/transport-subdomain#svc/commercial-bus>, <https://data.publicinformation.ie/ns/transport-subdomain#svc/rail>, <https://data.publicinformation.ie/ns/transport-subdomain#svc/light-rail>, <https://data.publicinformation.ie/ns/transport-subdomain#svc/spsv>, <https://data.publicinformation.ie/ns/transport-subdomain#svc/school-transport>, <https://data.publicinformation.ie/ns/transport-subdomain#svc/shared-mobility>, <https://data.publicinformation.ie/ns/transport-subdomain#users/vehicles-drivers>, <https://data.publicinformation.ie/ns/transport-subdomain#users/traffic-law> .

<https://data.publicinformation.ie/ns/transport-subdomain#infra/national-roads>
    a skos:Concept ;
    skos:notation "infra/national-roads"@en ;
    skos:prefLabel "National roads"@en ;
    skos:definition "national roads and motorways"@en ;
    skos:note "Retired. Replaced by the transport-activity grouping RT1."@en ;
    owl:deprecated true ;
    dct:isReplacedBy <https://data.publicinformation.ie/ns/transport-activity#RT1> ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-subdomain> .

