{
  "type": "object",
  "required": ["metadata", "results"],
  "properties": {
    "metadata": { "type": "object" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["public_body_id", "minutes_page_url", "source_method"],
        "properties": {
          "public_body_id": { "type": "integer" },
          "municipal_district": { "type": ["string", "null"] },
          "minutes_page_url": { "type": "string", "format": "uri" },
          "source_method": { "enum": ["override", "crawl"] },
          "overridden": { "type": "boolean" },
          "walk": {
            "type": "object",
            "required": ["detail_url", "detail_text", "paginate", "max_listing_pages"],
            "properties": {
              "detail_url": { "type": "string" },
              "detail_text": { "type": "string" },
              "paginate": { "enum": ["next", "prev"] },
              "max_listing_pages": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
