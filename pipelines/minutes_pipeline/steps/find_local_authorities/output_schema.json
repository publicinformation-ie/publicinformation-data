{
  "type": "object",
  "required": ["metadata", "results"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["step", "completed_at"],
      "properties": {
        "step": { "type": "string" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["public_body_id", "name", "slug", "official_website_url", "municipal_districts"],
        "properties": {
          "public_body_id": { "type": "integer" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "official_website_url": { "type": ["string", "null"], "format": "uri" },
          "municipal_districts": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
