    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-14a>
    a skos:Concept ;
    skos:notation "RT-14a" ;
    skos:prefLabel "Provide and maintain bus stop civil works"@en ;
    skos:definition "Kerbs, hardstanding, footpath links and other civil works at bus stops, and approval of bus stop locations (s.16 RTA 2002; S.I. 12 of 2013)."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT4> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S2, S3, S4, S5, S5G, S6, S7a, S7b, S7c, S9, S10, S12, S13b, S15"@en ;
