    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-09>
    a skos:Concept ;
    skos:notation "RT-09" ;
    skos:prefLabel "Provide, maintain and renew local and regional cycle networks"@en ;
    skos:definition "Cycling infrastructure on roads and other public routes (excluding greenways, RT-10) across all applicable stages, including maintenance and renewal (S12)."@en ;
