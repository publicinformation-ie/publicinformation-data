    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-17>
    a skos:Concept ;
    skos:notation "RT-17" ;
    skos:prefLabel "Plan road passenger transport networks and services"@en ;
    skos:definition "Network-wide service design, route planning, frequency and service integration for bus and other road passenger transport. Route design for TFI Local Link services sits in RT-19.S2 (boundary rule B13)."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT5> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S3, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-18>
    a skos:Concept ;
    skos:notation "RT-18" ;
    skos:prefLabel "Administer fares and passenger service arrangements"@en ;
    skos:definition "Fare structures and service arrangements where the relevant public authority has responsibility. Separate from infrastructure and operator licensing."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT5> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S13a, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-19>
    a skos:Concept ;
    skos:notation "RT-19" ;
    skos:prefLabel "Coordinate rural and community transport services"@en ;
    skos:definition "Planning, coordination and development of rural and community road passenger transport services, including TFI Local Link. The NTA is responsible; 15 Transport Co-ordination Units administer operator contracts on its behalf. The LA has no funding, procurement or operating role in this activity; LA decisions sit in RT-14a.S13b (stop approvals), RT-15 (interchanges), X-08.S1 and RT-32.S2."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT5> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S3, S9, S11, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-20>
    a skos:Concept ;
    skos:notation "RT-20" ;
    skos:prefLabel "Plan and provide road freight and logistics facilities"@en ;
    skos:definition "Road-based freight hubs, loading facilities and last-mile logistics facilities."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT6> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S3, S4, S5, S5G, S6, S7a, S7c, S8, S9, S10, S11, S12, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-21>
    a skos:Concept ;
    skos:notation "RT-21" ;
    skos:prefLabel "Manage local freight access and delivery arrangements"@en ;
    skos:definition "Local freight access arrangements, delivery windows and freight movement plans. Separate physical facilities from regulatory restrictions."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT6> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S13a, S14, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-22>
    a skos:Concept ;
    skos:notation "RT-22" ;
    skos:prefLabel "Plan and manage public parking and kerbside space"@en ;
    skos:definition "On-street and off-street parking policy, parking supply, charges, permits, loading bays and kerbside allocation."@en ;
