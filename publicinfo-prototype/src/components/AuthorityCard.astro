---
interface Props {
  authority: {
    public_body_id: number;
    public_body_name: string;
    public_body_short_name?: string;
    public_body_category: string;
    public_body_url?: string;
  };
}

const { authority } = Astro.props;
---

<article class="authority-card">
  <div class="authority-card__border"></div>
  <div class="authority-card__content">
    <span class="authority-card__category">{authority.public_body_category}</span>
    <h3 class="authority-card__title">
      <a href={`/body/${authority.public_body_id}`} class="authority-card__link">
        {authority.public_body_name}
      </a>
    </h3>
    <a href={`/body/${authority.public_body_id}`} class="authority-card__action">
      View
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .authority-card {
    position: relative;
    border: 1px solid var(--color-grey-light);
    border-radius: 4px;
    padding: var(--space-4);
    background-color: var(--color-white);
  }

  .authority-card__border {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background-color: var(--color-primary);
    border-radius: 4px 0 0 4px;
  }

  .authority-card__content {
    padding-left: var(--space-3);
  }

  .authority-card__category {
    display: inline-block;
    font-size: var(--text-body-xs);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-grey-dark);
    margin-bottom: var(--space-1);
  }

  .authority-card__title {
    font-size: var(--text-m);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--space-2);
  }

  .authority-card__link {
    color: var(--color-primary);
    text-decoration: none;
  }

  .authority-card__link:hover,
  .authority-card__link:focus {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .authority-card__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
    font-size: var(--text-body-s);
  }

  .authority-card__action:hover,
  .authority-card__action:focus {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .authority-card:hover {
    background-color: var(--color-grey-lightest);
  }
</style>
