    skos:scopeNote "Kind: body"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-raci-party> .

<https://data.publicinformation.ie/ns/transport-raci-party#RSA>
    a skos:Concept ;
    skos:notation "RSA" ;
    skos:prefLabel "Road Safety Authority"@en ;
    skos:definition "The national road safety body."@en ;
    skos:exactMatch <https://data.publicinformation.ie/body/road-safety-authority> ;
    skos:altLabel "the Road Safety Authority"@en ;
    skos:scopeNote "Kind: body"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-raci-party> .

<https://data.publicinformation.ie/ns/transport-raci-party#HSE>
    a skos:Concept ;
