    skos:note "Status: active"@en ;
    skos:note "Stages: S2, S10, S12, S13a"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-24>
    a skos:Concept ;
    skos:notation "RT-24" ;
    skos:prefLabel "Make and administer local road traffic and speed-limit bye-laws"@en ;
    skos:definition "Special speed-limit bye-laws under s.9 RTA 2004 (reserved, s.9(10)), including 30 km/h urban limits, and other local road traffic bye-laws. Excludes national managed roads (RT-25), national default limits (RT-40) and road works speed limit orders (RT-37, boundary rule B12). S5G covers TII's prior consent on national roads."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT8> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S5G, S13a, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-25>
    a skos:Concept ;
    skos:notation "RT-25" ;
    skos:prefLabel "Set or amend speed limits on national roads"@en ;
    skos:definition "Speed-limit decisions on national roads: TII bye-laws on national managed roads (s.9A RTA 2004); LA bye-laws on other national roads with TII's prior written consent (s.9(7)). S5G follows boundary rule B9."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT8> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S2, S5G, S13a, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

