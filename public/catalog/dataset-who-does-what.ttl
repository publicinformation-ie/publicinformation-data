    prov:wasGeneratedBy [
        a prov:Activity ;
        prov:startedAtTime "2026-07-08T00:00:00Z"^^xsd:dateTime ;
        prov:wasAssociatedWith [
            a prov:Agent ;
            prov:actedOnBehalfOf <https://www.publicinformation.ie/> ;
