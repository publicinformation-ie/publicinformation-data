    a skos:Concept ;
    skos:notation "RT-05" ;
    skos:prefLabel "Plan and manage pedestrian networks"@en ;
    skos:definition "Planning, development and management of public pedestrian routes and footpath networks."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT2> ;
