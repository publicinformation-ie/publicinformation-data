---
interface Props {
  dataset: 'all' | 'government-department' | 'public-service-body' | 'local-authority';
  label?: string;
}

const { dataset, label = 'Download:' } = Astro.props;
---

<div class="download-buttons">
  {label && <span class="download-buttons__label">{label}</span>}
  <a
    href={`/downloads/${dataset}.csv`}
    class="download-btn download-btn--csv"
    download
  >
    ↓ CSV
  </a>
  <a
    href={`/downloads/${dataset}.json`}
    class="download-btn download-btn--json"
    download
  >
    ↓ JSON
  </a>
</div>

<style>
  .download-buttons {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .download-buttons__label {
    font-size: var(--text-body-s);
    color: var(--color-grey-dark);
    margin-right: var(--space-1);
  }

  .download-btn {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-body-xs);
    font-weight: 700;
    text-decoration: none;
    border-radius: 2px;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .download-btn--csv {
    background-color: var(--color-primary);
    color: var(--color-white);
    border: 2px solid var(--color-primary);
  }

  .download-btn--csv:hover {
    background-color: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    color: var(--color-white);
  }

  .download-btn--json {
    background-color: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }

  .download-btn--json:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .download-btn:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
