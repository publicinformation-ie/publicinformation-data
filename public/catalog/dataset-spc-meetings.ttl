<https://data.publicinformation.ie/dataset/spc-meetings>
    a dcat:Dataset ;
    dct:title "Strategic Policy Committee Meetings"@en ;
    dct:description "Meetings of Irish local authority Strategic Policy Committees: who attended, their attendance, agenda items with COFOG 1999 topics, official decisions as verbatim quotes, and the minutes rendered verbatim as Markdown."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
    dct:issued "2026-11-26"^^xsd:date ;
    dct:modified "2026-11-26"^^xsd:date ;
    owl:versionInfo "1.1.0" ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:keyword "SPC", "committee minutes", "attendance", "local authorities", "Ireland", "open data"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "PublicInformation.ie" ;
        vcard:hasEmail <mailto:dave@publicinformation.ie> ;
    ] ;
    dct:relation <https://data.publicinformation.ie/dataset/public-bodies> ;
    dct:relation <https://data.publicinformation.ie/dataset/motions> ;

