<https://data.publicinformation.ie/ns/transport-activity#RT-10>
    a skos:Concept ;
    skos:notation "RT-10" ;
    skos:prefLabel "Develop and maintain greenways"@en ;
    skos:definition "Plan, construct, improve, operate, regulate and maintain greenways. All greenways are treated as serving a transport function. S13a covers greenway bye-laws and S14 their enforcement."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT3> ;
    skos:note "Status: active"@en ;
