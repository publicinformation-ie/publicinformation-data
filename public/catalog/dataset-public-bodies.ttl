@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://codeberg.org/publicinformation-ie/publicinformation-data/dataset/public-bodies>
    a dcat:Dataset ;
    dct:title "Public Bodies in Ireland"@en ;
    dct:description "A comprehensive list of all public bodies in Ireland, including their FOI status and scope."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
    dct:issued "2026-07-01"^^xsd:date ;
    dct:modified "2026-07-01"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:accrualPeriodicity <http://purl.org/cld/freq/daily> ;
    dcat:keyword "public bodies", "FOI", "Ireland", "government"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "PublicInformation.ie" ;
        vcard:hasEmail <mailto:dave@publicinformation.ie> ;
    ] ;
    prov:hadPrimarySource <https://foi.gov.ie/all-foi-bodies> ;

    dcat:distribution [
        a dcat:Distribution ;
        dct:title "Public Bodies (JSON-LD)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ;
        dcat:accessURL <https://codeberg.org/publicinformation-ie/publicinformation-data/public-bodies.jsonld> ;
        dcat:downloadURL <https://codeberg.org/publicinformation-ie/publicinformation-data/public-bodies.jsonld> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "application/ld+json" ;
        dct:conformsTo <https://codeberg.org/publicinformation-ie/publicinformation-data/schemas/public-bodies.schema.json> ;
    ] , [
        a dcat:Distribution ;
        dct:title "Public Bodies (CSV)"@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
        dcat:accessURL <https://codeberg.org/publicinformation-ie/publicinformation-data/public-bodies.csv> ;
        dcat:downloadURL <https://codeberg.org/publicinformation-ie/publicinformation-data/public-bodies.csv> ;
        dct:conformsTo <http://www.w3.org/ns/csvw> ;
        dct:conformsTo <https://codeberg.org/publicinformation-ie/publicinformation-data/public-bodies.csv-metadata.json> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "text/csv" ;
    ] .

<https://codeberg.org/publicinformation-ie/publicinformation-data/dataset/public-bodies>
    prov:wasGeneratedBy [
        a prov:Activity ;
        prov:startedAtTime "2026-07-01T00:00:00Z"^^xsd:dateTime ;
        prov:wasAssociatedWith [
            a prov:Agent ;
            prov:actedOnBehalfOf <https://www.publicinformation.ie/> ;
            foaf:name "PublicInformation.ie Pipeline" ;
            foaf:homepage <https://codeberg.org/publicinformation-ie/publicinformation-data> ;
        ] ;
    ] .
