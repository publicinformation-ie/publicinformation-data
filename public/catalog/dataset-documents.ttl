@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://data.publicinformation.ie/dataset/documents>
    a dcat:Dataset ;
    dct:title "Public-Interest Documents from Irish Public Bodies"@en ;
    dct:description "Large public-interest PDFs (transport strategies, statutory reviews, policy reports) published by Irish public bodies, split into per-section Markdown plus extracted figures and packaged as one reproducible bundle per document. Each document optionally links to the public body that published it in the Public Bodies dataset. See docs/superpowers/specs/2026-08-10-document-bundle-contract.md in the source repository for the full bundle and index.json shape this dataset guarantees."@en ;
    dct:publisher <https://www.publicinformation.ie/> ;
    dct:creator <https://www.publicinformation.ie/> ;
    dct:issued "2026-08-11"^^xsd:date ;
    dct:modified "2026-08-11"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:keyword "documents", "transport strategy", "policy report", "Ireland", "government", "open data"@en ;
    dcat:theme <http://data.europa.eu/m8g/GOVERNMENT> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "PublicInformation.ie" ;
        vcard:hasEmail <mailto:dave@publicinformation.ie> ;
    ] ;
    dct:relation <https://data.publicinformation.ie/dataset/public-bodies> ;

    dcat:distribution [
        a dcat:Distribution ;
        dct:title "Documents Library Index (JSON)"@en ;
        dct:description "One record per published document: title, publisher, page/chapter/section/figure counts, the relative path and sha256 of its bundle.tar.gz, and its source PDF's sha256 for provenance. A document that fails to build is listed under `failed`, never half-published under `documents`."@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ;
        dcat:accessURL <https://data.publicinformation.ie/documents/index.json> ;
        dcat:downloadURL <https://data.publicinformation.ie/documents/index.json> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        dcat:mediaType "application/json" ;
    ] , [
        a dcat:Distribution ;
        dct:title "Per-Document Bundle (gzipped tar)"@en ;
        dct:description "One archive per document — meta.json (contract record plus navigation tree), llms.txt, full.md, sections/<chapter-slug>/<section-slug>.md and assets/<figure-id>.webp — at <index.json's `bundle` path>, e.g. documents/<doc-slug>/bundle.tar.gz. llms.txt and full.md are also published loose at documents/<doc-slug>/llms.txt and documents/<doc-slug>/full.md."@en ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/TAR> ;
        dcat:mediaType "application/gzip" ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    ] .

<https://data.publicinformation.ie/dataset/documents>
    prov:wasGeneratedBy [
        a prov:Activity ;
        prov:startedAtTime "2026-08-11T00:00:00Z"^^xsd:dateTime ;
        prov:wasAssociatedWith [
            a prov:Agent ;
            prov:actedOnBehalfOf <https://www.publicinformation.ie/> ;
            foaf:name "PublicInformation.ie Pipeline" ;
            foaf:homepage <https://github.com/publicinformation-ie/publicinformation-data> ;
        ] ;
    ] .
