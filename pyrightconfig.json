{
  "typeCheckingMode": "basic",
  "pythonVersion": "3.14",
  "include": ["src"],
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": ["src"],
  "exclude": [
    "**/.venv",
    "**/site-packages",
    ".claude",
    "**/worktrees",
    ".worktrees",
    "public",
    "pipelines/*/steps/*/output.json"
  ],
  "reportMissingModuleSource": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownVariableType": "none"
}
