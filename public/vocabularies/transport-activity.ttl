    a skos:Concept ;
    skos:notation "RT-29" ;
    skos:prefLabel "Manage road traffic calming and physical public-realm reallocation"@en ;
    skos:definition "Design and implementation of physical traffic-calming measures and reallocation of road space. Excludes policing, enforcement and signal control operations."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT8> ;
