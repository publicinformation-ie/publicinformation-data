    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-11>
    a skos:Concept ;
    skos:notation "RT-11" ;
    skos:prefLabel "Provide and maintain cycle parking in the public realm"@en ;
    skos:definition "Publicly accessible bicycle parking and associated facilities in the public realm, including near educational institutions and bike-share docking stations, racks and bays."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT3> ;
