public/**/*.csv filter=lfs diff=lfs merge=lfs -text
public/**/*.xlsx filter=lfs diff=lfs merge=lfs -text
pipelines/foi_pipeline/steps/transform_disclosure_files/ocr_cache/*.json filter=lfs diff=lfs merge=lfs -text
