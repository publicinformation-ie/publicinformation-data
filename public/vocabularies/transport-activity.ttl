<https://data.publicinformation.ie/ns/transport-activity#RT-01>
    a skos:Concept ;
    skos:notation "RT-01" ;
    skos:prefLabel "Construct, improve and renew national roads"@en ;
    skos:definition "Physical construction, improvement and major renewal of national road assets. Distinguish statutory road authority functions, TII oversight and project delivery."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT1> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S3, S4, S5, S5G, S6, S7a, S7b, S7c, S8, S9, S10, S12, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-02>
    a skos:Concept ;
    skos:notation "RT-02" ;
    skos:prefLabel "Maintain and rehabilitate regional and local roads"@en ;
    skos:definition "Routine and periodic maintenance, pavement renewal (e.g. surface dressing, strengthening/resurfacing) and rehabilitation of regional and local roads. Statutory duty of the road authority under s.13 Roads Act 1993; funded by own resources plus DoT Protection and Renewal grants. Improvement and new construction: RT-35; winter and emergency maintenance: RT-39. S6 covers conditional AA/EIA screening and exemption check."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT1> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S2, S3, S4, S6, S9, S12, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-03>
    a skos:Concept ;
    skos:notation "RT-03" ;
    skos:prefLabel "Manage road bridges, structures and drainage"@en ;
    skos:definition "Lifecycle management, inspection, maintenance and renewal of bridges, retaining structures, culverts and road drainage."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT1> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S3, S4, S5, S5G, S6, S7a, S7c, S8, S9, S10, S12, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-04>
    a skos:Concept ;
    skos:notation "RT-04" ;
    skos:prefLabel "Provide and maintain road signs and markings"@en ;
    skos:definition "Road signs, road markings, delineation and associated physical road safety assets, including speed-limit signs. Excludes enforcement."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT1> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S2, S3, S4, S5, S5G, S6, S7a, S7b, S7c, S9, S10, S12, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

