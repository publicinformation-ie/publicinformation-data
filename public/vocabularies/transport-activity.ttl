    a skos:Concept ;
    skos:notation "RT-06" ;
    skos:prefLabel "Construct and maintain footpaths and pedestrian routes"@en ;
    skos:definition "Provision, repair and maintenance of footpaths and pedestrian links within the relevant public realm."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT2> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S3, S4, S5, S5G, S6, S7a, S7b, S7c, S8, S9, S10, S12, S15"@en ;
