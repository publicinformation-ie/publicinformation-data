---
import Layout from '../../layouts/Layout.astro';
import bodies from '../../data/public_bodies_detailed.json';

// Generate static paths for all public bodies
export function getStaticPaths() {
  return Object.values(bodies).map((body: any) => ({
    params: { id: body.public_body_id.toString() },
  }));
}

const { id } = Astro.params;
const body = Object.values(bodies).find((b: any) => b.public_body_id == id);

if (!body) {
  Astro.redirect('/404', 404);
}
---

<Layout title={`${body.public_body_name} - Public Bodies in Ireland`} showBackLink={true}>
  <div class="page-container">
    <article class="body-detail">
      <!-- Header -->
      <header class="body-detail__header">
        <span class="body-detail__category">{body.public_body_category}</span>
        <h1 class="body-detail__title">{body.public_body_name}</h1>
        {body.public_body_short_name && (
          <p class="body-detail__short-name">{body.public_body_short_name}</p>
        )}
      </header>

      <!-- Main content grid -->
      <div class="body-detail__grid">
        <!-- Left column: Info -->
        <aside class="body-detail__sidebar">
          <section class="info-panel">
            <h2 class="info-panel__title">Quick Links</h2>
            <nav class="info-panel__nav" aria-label="Quick links">
              <ul class="info-panel__list">
                {body.public_body_url && (
                  <li class="info-panel__item">
                    <a 
                      href={body.public_body_url}
                      class="info-panel__link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Official Website
                    </a>
                  </li>
                )}
                {body.foi_disclosure_page_url && (
                  <li class="info-panel__item">
                    <a 
                      href={body.foi_disclosure_page_url}
                      class="info-panel__link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      FOI Disclosures
                    </a>
                  </li>
                )}
                {body.foi_contact_email && (
                  <li class="info-panel__item">
                    <a 
                      href={`mailto:${body.foi_contact_email}`}
                      class="info-panel__link"
                    >
                      Send FOI Request
                    </a>
                  </li>
                )}
              </ul>
            </nav>
          </section>
          
          {body.disclosure_files && body.disclosure_files.length > 0 && (
            <section class="stats-panel">
              <h2 class="stats-panel__title">Disclosure Files</h2>
              <p class="stats-panel__value">{body.disclosure_files.length}</p>
              <p class="stats-panel__label">Public documents</p>
            </section>
          )}
        </aside>

        <!-- Right column: Files -->
        <main class="body-detail__main">
          <!-- Files -->
          <section class="files-section">
            <h2 class="files-section__title">Disclosure Documents</h2>
            
            {body.disclosure_files && body.disclosure_files.length > 0 ? (
              <ul class="files-list">
                {body.disclosure_files.map((file: any, index: number) => (
                  <li key={index} class="files-list__item">
                    <div class="file-entry">
                      <div class="file-entry__meta">
                        <span class="file-entry__date">{file.date_added}</span>
                      </div>
                      <div class="file-entry__body">
                        <code class="file-entry__name">{file.document_name}</code>
                        <a 
                          href={file.document_url}
                          class="file-entry__download"
                          target="_blank"
                          rel="noopener noreferrer"
                          download
                        >
                          <span class="file-entry__download-icon" aria-hidden="true">↓</span>
                          <span class="file-entry__download-text">Download</span>
                        </a>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="files-empty">No disclosure files published.</p>
            )}
          </section>
        </main>
      </div>
    </article>
  </div>
</Layout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .body-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Header */
  .body-detail__header {
    padding-top: var(--space-4);
  }

  .body-detail__category {
    display: inline-block;
    margin-bottom: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-body-xs);
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 2px;
  }

  .body-detail__title {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 var(--space-2);
  }

  .body-detail__short-name {
    color: var(--color-grey-dark);
    font-size: var(--text-l);
    margin: 0;
  }

  /* Grid */
  .body-detail__grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-6);
  }

  /* Sidebar */
  .body-detail__sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .info-panel {
    border: 1px solid var(--color-grey-light);
    border-radius: 4px;
    padding: var(--space-4);
    background-color: var(--color-white);
  }

  .info-panel__title {
    font-size: var(--text-s);
    font-weight: 700;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-grey-light);
  }

  .info-panel__nav {
    margin: 0;
  }

  .info-panel__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .info-panel__item {
    margin-bottom: var(--space-2);
  }

  .info-panel__link {
    display: block;
    padding: var(--space-2);
    color: var(--color-primary);
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.2s ease-in-out;
  }

  .info-panel__link:hover,
  .info-panel__link:focus {
    background-color: var(--color-grey-lightest);
    color: var(--color-primary-dark);
    text-decoration: none;
  }

  /* Stats Panel */
  .stats-panel {
    border: 1px solid var(--color-grey-light);
    border-radius: 4px;
    padding: var(--space-4);
    background-color: var(--color-grey-lightest);
    text-align: center;
  }

  .stats-panel__title {
    font-size: var(--text-body-s);
    font-weight: 600;
    color: var(--color-grey-dark);
    margin-bottom: var(--space-1);
  }

  .stats-panel__value {
    font-size: var(--text-l);
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 var(--space-1);
  }

  .stats-panel__label {
    font-size: var(--text-body-xs);
    color: var(--color-grey-mid);
    margin: 0;
  }

  /* Main content */
  .body-detail__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Files */
  .files-section {
    border: 1px solid var(--color-grey-light);
    border-radius: 4px;
    padding: var(--space-4);
    background-color: var(--color-white);
  }

  .files-section__title {
    font-size: var(--text-m);
    font-weight: 700;
    margin: 0 0 var(--space-4);
  }

  .files-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .files-list__item {
    margin-bottom: var(--space-3);
  }

  .file-entry {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-grey-light);
    border-radius: 4px;
    background-color: var(--color-grey-lightest);
    align-items: flex-start;
  }

  .file-entry__meta {
    flex-shrink: 0;
  }

  .file-entry__date {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-white);
    color: var(--color-grey-dark);
    font-size: var(--text-body-xs);
    font-weight: 600;
    border-radius: 2px;
    border: 1px solid var(--color-grey-light);
  }

  .file-entry__body {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .file-entry__name {
    font-family: monospace;
    font-size: var(--text-body-s);
    word-break: break-all;
    background-color: var(--color-white);
    padding: var(--space-1) var(--space-2);
    border-radius: 2px;
    border: 1px solid var(--color-grey-light);
  }

  .file-entry__download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-primary);
    color: var(--color-white);
    text-decoration: none;
    font-size: var(--text-body-s);
    font-weight: 600;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .file-entry__download:hover,
  .file-entry__download:focus {
    background-color: var(--color-primary-dark);
    color: var(--color-white);
    text-decoration: none;
  }

  .files-empty {
    color: var(--color-grey-mid);
    font-style: italic;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .body-detail__grid {
      grid-template-columns: 1fr;
    }

    .body-detail__sidebar {
      order: 1;
    }

    .body-detail__main {
      order: 0;
    }
  }

  @media (max-width: 639px) {
    .body-detail__title {
      font-size: var(--text-l);
    }

    .file-entry__body {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
