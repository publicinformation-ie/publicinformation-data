{
  "type": "object",
  "required": ["metadata", "results"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["step", "completed_at"],
      "properties": {
        "step": { "type": "string" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["public_body_id", "foi_page_url", "disclosure_page_url"],
        "properties": {
          "public_body_id": { "type": "integer" },
          "foi_page_url": { "type": "string" },
          "disclosure_page_url": { "type": "string" }
        }
      }
    }
  }
}
