    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-30>
    a skos:Concept ;
    skos:notation "RT-30" ;
    skos:prefLabel "Administer active travel and road transport capital programmes"@en ;
    skos:definition "Retired activity. Retired. Programme-level functions now sit in X-17; project allocation in S3 of each asset activity. Row retained for traceability only."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT9> ;
    skos:note "Status: retired"@en ;
    skos:note "Stages: none"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-31>
    a skos:Concept ;
    skos:notation "RT-31" ;
    skos:prefLabel "Manage transport infrastructure projects and statutory planning processes"@en ;
    skos:definition "Retired activity. Retired. Now stages S5–S9 of each asset activity, with consent routes S7a–S7c. Row retained for traceability only."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT9> ;
    skos:note "Status: retired"@en ;
    skos:note "Stages: none"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-32>
    a skos:Concept ;
    skos:notation "RT-32" ;
    skos:prefLabel "Plan and integrate local transport networks"@en ;
    skos:definition "Strategic coordination of road transport networks and their interfaces with other modes and land-use planning, including Local Transport Plans."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT9> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S6, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

