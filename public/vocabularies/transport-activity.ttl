    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-42>
    a skos:Concept ;
    skos:notation "RT-42" ;
    skos:prefLabel "Provide and maintain traffic signal and ITS assets"@en ;
    skos:definition "Physical traffic signals, detectors, cameras and other ITS equipment on the road. Operation and control of signals stays in X-01."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT1> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S2, S3, S4, S5, S5G, S6, S7a, S7b, S7c, S9, S10, S11, S12, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#WT-01>
    a skos:Concept ;
    skos:notation "WT-01" ;
    skos:prefLabel "Plan and develop commercial port infrastructure"@en ;
    skos:definition "Strategic planning and development of port infrastructure, distinguishing port-company functions from statutory planning authority decisions."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#WT1> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S3, S4, S5, S5G, S6, S7a, S7c, S8, S9, S10, S11, S12, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#WT-02>
    a skos:Concept ;
    skos:notation "WT-02" ;
    skos:prefLabel "Own, operate and maintain local authority piers and harbours"@en ;
    skos:definition "Management, operation, maintenance and renewal of Local Authority-owned or controlled piers, harbours and marine assets."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#WT1> ;
    skos:note "Status: active"@en ;
