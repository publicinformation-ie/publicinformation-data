    a skos:Concept ;
    skos:notation "RT-38" ;
    skos:prefLabel "Declare public roads and take roads in charge"@en ;
    skos:definition "Declaring roads public and taking estate roads, footpaths and public lighting in charge (s.11 Roads Act 1993; s.180 PDA 2000 until 25 Nov 2026, then s.261 PDA 2024, with s.263 transitional); extinguishing public rights of way. Transfers maintenance responsibility to the Local Authority. The order sits in S7D."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT9> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S5G, S7D, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-39>
    a skos:Concept ;
    skos:notation "RT-39" ;
    skos:prefLabel "Provide winter and emergency road maintenance"@en ;
    skos:definition "Winter service (salting/gritting priorities), storm, flood and emergency response on the road network, including footways and cycle routes where included in the winter service plan."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT1> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S2, S3, S11, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-40>
    a skos:Concept ;
    skos:notation "RT-40" ;
    skos:prefLabel "Set national default speed limits"@en ;
    skos:definition "Default speed limits for classes of road set in RTA 2004 as amended by RTA 2024, and their commencement. Rural local roads 60 km/h from 7 Feb 2025; the built-up 30 km/h and national road changes are enacted but not commenced. Not an LA function. Signs: RT-04."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT8> ;
    skos:note "Status: active"@en ;
    skos:note "Stages: S1, S13a, S15"@en ;
    skos:inScheme <https://data.publicinformation.ie/ns/transport-activity> .

<https://data.publicinformation.ie/ns/transport-activity#RT-41>
    a skos:Concept ;
    skos:notation "RT-41" ;
    skos:prefLabel "Provide and operate shared bicycle and micromobility services"@en ;
    skos:definition "Funding, procurement and operation of public bike-share and shared micromobility services: NTA model (TFI Bikes contract) or LA model (procured or concession pilots). Separate from regulation (RT-26) and from stations, racks and bays (RT-11)."@en ;
    skos:broader <https://data.publicinformation.ie/ns/transport-activity#RT5> ;
    skos:note "Status: active"@en ;
