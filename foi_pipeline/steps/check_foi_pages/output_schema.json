{
  "type": "object",
  "required": ["metadata", "results"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["step", "completed_at"],
      "properties": {
        "step": { "type": "string" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["public_body_id", "name", "official_website_url", "foi_page_url", "source_method", "is_reachable", "http_status", "checked_at"],
        "properties": {
          "public_body_id": { "type": "integer" },
          "name": { "type": "string" },
          "official_website_url": { "type": "string" },
          "foi_page_url": { "type": "string" },
          "source_method": { "enum": ["crawl", "serper", "manual"] },
          "is_reachable": { "type": "boolean" },
          "http_status": { "type": ["integer", "null"] },
          "checked_at": { "type": "string", "format": "date-time" },
          "overridden": { "type": "boolean" }
        }
      }
    }
  }
}
